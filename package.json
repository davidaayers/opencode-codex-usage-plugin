{
  "name": "@davidaayers/opencode-codex-usage-plugin",
  "version": "1.0.1",
  "description": "OpenCode TUI plugin that shows Codex quota usage gauges and reset times.",
  "keywords": [
    "codex",
    "opencode",
    "opencode-plugin",
    "tui",
    "usage"
  ],
  "homepage": "https://github.com/davidaayers/opencode-codex-usage-plugin#readme",
  "bugs": {
    "url": "https://github.com/davidaayers/opencode-codex-usage-plugin/issues"
  },
  "license": "MIT",
  "author": "David Ayers",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/davidaayers/opencode-codex-usage-plugin.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    "./tui": "./dist/tui.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun build.mjs",
    "format": "oxfmt . --write",
    "format:check": "oxfmt . --check",
    "prepack": "bun build.mjs",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build",
    "prepare": "effect-language-service patch",
    "test": "vitest run src",
    "test:pack": "bun test --conditions=browser packed-install.test.mjs",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck && pnpm test && pnpm test:pack"
  },
  "devDependencies": {
    "@effect/language-service": "0.86.2",
    "@effect/vitest": "4.0.1",
    "@opencode/plugin": "2.1.3",
    "@opencode/theme": "2.1.3",
    "@opentui/core": "^0.6.6",
    "@opentui/solid": "^0.6.6",
    "@types/codex-websocket": "npm:@types/ws@^8.18.1",
    "@types/node": "^24.10.1",
    "codex-websocket": "npm:ws@^8.22.0",
    "effect": "4.0.1",
    "effect-solutions": "^0.5.3",
    "oxfmt": "^0.56.0",
    "solid-js": "1.9.12",
    "typescript": "^5.9.3",
    "vitest": "5.0.5"
  },
  "engines": {
    "opencode": ">=2.1.3 <3"
  },
  "packageManager": "pnpm@10.33.0"
}
